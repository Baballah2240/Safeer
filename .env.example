# Examples only: scripts do not automatically load this file.
# Prefer npm run local on Windows for an isolated private development database.
# Manual setup: set these privately in each process, never in public JS.
# SAFEER_DATABASE_URL=postgresql://<migration-user>:<secret>@127.0.0.1:5432/<local_database>
# SAFEER_AUTH_DATABASE_URL=postgresql://safeer_app:<secret>@127.0.0.1:5432/<local_database>
# SAFEER_AUTH_API_URL=http://127.0.0.1:4321
# SAFEER_WEB_ORIGIN=http://127.0.0.1:4320
SAFEER_AUTH_PORT=4321
SAFEER_PORT=4320
