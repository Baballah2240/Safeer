{
  "name": "safeer",
  "version": "0.16.0",
  "private": true,
  "type": "module",
  "description": "Section 15 verified local passenger transport with security configuration checks, maintenance health and release/recovery tooling",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server.mjs",
    "test": "npm run build:api && node --test tests/*.test.mjs",
    "build": "npm run build:api && node scripts/build.mjs",
    "start:built": "node server.mjs --built",
    "db:migrate": "node database/migrate.mjs up",
    "db:status": "node database/migrate.mjs status",
    "test:db": "node --test tests/database.integration.mjs",
    "test:browser": "node tests/browser.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check": "npm test && npm run build && npm run check:docs",
    "build:api": "tsc -p apps/api/tsconfig.json",
    "identity:start": "node dist/api/main.js",
    "identity:bootstrap": "node dist/api/admin.js bootstrap",
    "local": "npm run build && node scripts/local.mjs",
    "test:identity": "node --test tests/identity.integration.mjs",
    "test:identity:browser": "node tests/identity.browser.mjs",
    "local:backup": "node database/backup-local.mjs",
    "identity:recover": "node database/recover-owner.mjs",
    "identity:grant": "node database/grant-runtime.mjs",
    "test:companies": "node --test tests/companies.integration.mjs",
    "test:companies:browser": "node tests/companies.browser.mjs",
    "test:fleet": "node --test tests/fleet.integration.mjs",
    "test:fleet:browser": "node tests/fleet.browser.mjs",
    "test:trips": "node --test tests/trips.integration.mjs",
    "test:trips:browser": "node tests/trips.browser.mjs",
    "test:marketplace": "node --test tests/marketplace.integration.mjs",
    "test:marketplace:browser": "node tests/marketplace.browser.mjs",
    "test:reservations": "node --test tests/reservations.integration.mjs",
    "test:reservations:browser": "node tests/reservations.browser.mjs",
    "test:passengers": "node --test tests/passengers.integration.mjs",
    "test:ticketing": "node --test tests/ticketing.integration.mjs",
    "test:ticketing:browser": "node tests/ticketing.browser.mjs",
    "test:boarding": "node --test tests/boarding.integration.mjs",
    "test:boarding:browser": "node tests/boarding.browser.mjs",
    "test:luggage": "node --test tests/luggage.integration.mjs",
    "test:luggage:browser": "node tests/luggage.browser.mjs",
    "test:shipments": "node --test tests/shipments.integration.mjs",
    "test:platform": "node --test tests/platform.integration.mjs",
    "test:platform:browser": "node tests/platform.browser.mjs",
    "test:finance": "node --test tests/finance.integration.mjs",
    "test:finance:browser": "node tests/finance.browser.mjs",
    "test:security": "node --test tests/security.integration.mjs",
    "test:journey": "node --test tests/connected.integration.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "mobile:build": "node mobile/build.mjs",
    "mobile:save": "node mobile/save.mjs",
    "mobile:usb": "node mobile/usb.mjs",
    "mobile:install": "node mobile/install.mjs",
    "mobile:upload-key": "node mobile/upload-key.mjs",
    "mobile:release": "node mobile/release.mjs",
    "test:headers:browser": "node tests/headers.browser.mjs",
    "test:sidebar:browser": "node tests/sidebar.browser.mjs",
    "test:booking-menu:browser": "node tests/booking-menu.browser.mjs",
    "test:driver-menu:browser": "node tests/driver-menu.browser.mjs",
    "test:login:browser": "node tests/login.browser.mjs",
    "identity:recover:hosted": "node database/hosted-owner-recovery.mjs",
    "test:marketplace:regressions": "node tests/marketplace-regressions.browser.mjs",
    "mobile:build:hosted": "node mobile/build.mjs",
    "mobile:build:usb": "node mobile/build.mjs --usb",
    "mobile:save:usb": "node mobile/save.mjs --usb",
    "test:shipments:browser": "node tests/shipments.browser.mjs",
    "test:operations": "node --test tests/operations.integration.mjs",
    "test:operations:browser": "node tests/operations.browser.mjs",
    "mobile:build:driver": "node mobile/build.mjs --driver-only",
    "mobile:save:driver": "node mobile/save.mjs --driver-only",
    "test:passenger-accounts": "node --test tests/passenger-accounts.integration.mjs",
    "test:passenger-google": "node --test tests/passenger-google.integration.mjs",
    "test:staff-details": "node --test tests/staff-details.integration.mjs",
    "test:direct-permissions": "node --test tests/direct-permissions.integration.mjs",
    "test:direct-permissions:browser": "node tests/direct-permissions.browser.mjs",
    "test:workflow": "node --test tests/workflow.integration.mjs",
    "test:production": "node --test tests/production.integration.mjs",
    "test:audit-fixes": "node --test tests/audit-fixes.integration.mjs",
    "test:passenger-app:browser": "node tests/passenger-app-account.browser.mjs",
    "check:live": "node scripts/check-live.mjs"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "pg": "8.23.1",
    "qrcode-generator": "2.0.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.0.14",
    "@types/pg": "8.23.1",
    "jsqr": "1.4.0",
    "typescript": "6.0.3"
  },
  "optionalDependencies": {
    "@embedded-postgres/windows-x64": "18.4.0-beta.17"
  }
}
